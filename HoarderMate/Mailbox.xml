<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- HoarderMate tab content panel, overlays the mail inset -->
    <Frame name="HoarderMatePanel" parent="MailFrame" hidden="true">
        <Anchors>
            <Anchor point="TOPLEFT"     relativeTo="MailFrameInset" relativePoint="TOPLEFT"/>
            <Anchor point="BOTTOMRIGHT" relativeTo="MailFrameInset" relativePoint="BOTTOMRIGHT"/>
        </Anchors>
        <Frames>
            <ScrollFrame name="$parentSendScroll" inherits="UIPanelScrollFrameTemplate" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT"     x="4"   y="-4"/>
                    <Anchor point="BOTTOMRIGHT" x="-24" y="4"/>
                </Anchors>
                <ScrollChild>
                    <Frame name="HoarderMatePanelSendContent">
                        <Size>
                            <AbsDimension x="260" y="1"/>
                        </Size>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentLabel" inherits="GameFontNormal" justifyH="CENTER" text="HoarderMate">
                    <Anchors>
                        <Anchor point="CENTER" y="20"/>
                    </Anchors>
                </FontString>
                <FontString name="$parentSublabel" inherits="GameFontDisable" justifyH="CENTER"
                            text="Click the cogwheel to configure&#10;bankers and items.">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="$parentLabel" relativePoint="BOTTOM" y="-6"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <!-- Third mail tab -->
    <Button name="MailFrameTab3" parent="MailFrame" inherits="CharacterFrameTabButtonTemplate" text="HoarderMate">
        <Anchors>
            <Anchor point="LEFT" relativeTo="MailFrameTab2" relativePoint="RIGHT" x="-8"/>
        </Anchors>
    </Button>

    <!-- Config button, sits left of the close button. Same style as RaidSummon's
         settings button: a UIPanelButtonTemplate mini-button showing the options icon. -->
    <Button name="HoarderMateConfigButton" parent="MailFrame" inherits="UIPanelButtonTemplate" text="|TInterface\Buttons\UI-OptionsButton:0|t" hidden="false">
        <Size>
            <AbsDimension x="20" y="18"/>
        </Size>
        <Anchors>
            <Anchor point="RIGHT" relativeTo="MailFrameCloseButton" relativePoint="LEFT"/>
        </Anchors>
        <NormalFont style="GameFontNormalSmall"/>
        <HighlightFont style="GameFontHighlightSmall"/>
        <DisabledFont style="GameFontDisableSmall"/>
        <Scripts>
            <OnEnter>
                GameTooltip:SetOwner(self, "ANCHOR_LEFT")
                GameTooltip:SetText(HoarderMate.L["SettingsTooltip"])
                GameTooltip:Show()
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide()
            </OnLeave>
        </Scripts>
    </Button>

</Ui>
